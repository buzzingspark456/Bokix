VITE_SUPABASE_URL=https://byt-ut-mot-din-ditt-project-url.supabase.co
VITE_SUPABASE_ANON_KEY=byt-ut-mot-din-anon-key

# Bot-/captcha-skydd på inloggning och registrering (Cloudflare Turnstile,
# gratis) — se src/components/Turnstile.jsx för hela aktiveringsguiden.
# Site key är publik (VITE_-prefixad är okej här, till skillnad från
# Stripes hemliga nyckel nedan). Utan den här satt renderas ingen widget
# alls och inget bryts — men bot-skyddet är då avstängt.
VITE_TURNSTILE_SITE_KEY=byt-ut-mot-din-turnstile-site-key
# Secret key (HEMLIG) klistras INTE in här — den anges istället direkt i
# Supabase Dashboard → Authentication → Settings → "Enable Captcha
# protection". Supabase verifierar tokens direkt mot Cloudflare, appens
# egen backend är aldrig inblandad.

# Bot-/captcha-skydd på KONTAKTFORMULÄRET specifikt (Google reCAPTCHA v2
# Invisible, inte Turnstile ovan — se src/components/Recaptcha.jsx för
# varför två olika verktyg). Till skillnad från Turnstile/Supabase-paret
# verifierar VÅR EGEN backend (api/_recaptcha.js) token:en direkt mot
# Google, så secret key sätts här som en vanlig miljövariabel, aldrig
# VITE_-prefixad (hemlig, ska aldrig bundlas in i klient-JS).
VITE_RECAPTCHA_SITE_KEY=byt-ut-mot-din-recaptcha-site-key
RECAPTCHA_SECRET_KEY=byt-ut-mot-din-recaptcha-secret-key

# Stripe Connect
# Sida 37: aldrig VITE_-prefixad — Vite bundlar allt med det prefixet
# statiskt in i klient-JS, och det här är en hemlig nyckel.
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_ONBOARDING_RETURN_URL=http://localhost:5173
STRIPE_ONBOARDING_REFRESH_URL=http://localhost:5173
STRIPE_PLATFORM_URL=https://din-bokix-app.se
# Bokix egen avgift på kundfakturors kortbetalningar sätts INTE här längre
# (var tidigare STRIPE_PLATFORM_FEE_PERCENT, en fast procentsats) — den
# följer numera Stripes egen avgift dynamiskt, plus 1% marginal, via
# Stripes "Platform Pricing Tool" (ställs in i Stripe Dashboard under
# Connect-inställningarna, inte här). Se api/stripe/create-checkout-
# session.js:s kommentar för hela resonemanget.
# Delas av BÅDA Checkout-flödena — kunders fakturabetalningar
# (create-checkout-session.js) OCH Bokix egen prenumeration
# (create-subscription-checkout.js, Auth.jsx-registreringen). Basen är
# densamma; varje flöde lägger själv på sin egen ?query-parameter.
STRIPE_SUCCESS_URL=http://localhost:5173
STRIPE_CANCEL_URL=http://localhost:5173
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET_SNAPSHOT=whsec_xxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET_TUNNEL=whsec_xxxxxxxxxxxxxxxxxxxxx
# Se till att webhook-endpointen i Stripe Dashboard (eller `stripe listen`
# lokalt) skickar minst dessa händelser, annars uppdateras aldrig
# public.subscriptions (webhook.js/server.js):
#   checkout.session.completed, customer.subscription.created,
#   customer.subscription.updated, customer.subscription.deleted

# Stripe Connect OAuth (klassiskt "Standard"-konto-flöde — "Anslut Stripe" på Startsidan)
# client_id hittas i Stripe Dashboard under Connect > Inställningar > OAuth-inställningar.
# Kräver att Standard-konton är aktiverat för din Connect-plattform.
STRIPE_CONNECT_CLIENT_ID=ca_xxxxxxxxxxxxxxxxxxxxxxxx
# Måste matcha en redirect-URI registrerad i samma Stripe-inställningar.
STRIPE_OAUTH_REDIRECT_URI=http://localhost:5000/api/stripe/callback
# Valfri lång, slumpad sträng — signerar state-parametern (CSRF-skydd). Genereras t.ex. med:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
STRIPE_OAUTH_STATE_SECRET=byt-ut-mot-en-lang-slumpad-hemlig-strang

# Signerar den sexsiffriga e-postverifieringskoden i registreringens
# "Bekräfta e-post"-steg (api/auth/request-password-reset.js:s
# send-signup-code/verify-signup-code — se den filens kommentar för varför
# de ligger där). Egen hemlighet, oberoende av STRIPE_OAUTH_STATE_SECRET
# ovan trots samma slags HMAC-signering. Kräver ÄVEN att RESEND_API_KEY
# (se api/_resend.js) är satt, annars svarar send-signup-code 503. Genereras
# likadant:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SIGNED_TOKEN_SECRET=byt-ut-mot-en-annan-lang-slumpad-hemlig-strang

# Krävs för att OAuth-callbacken (som körs utan inloggad session) ska kunna
# spara stripeAccountId server-side. Hittas i Supabase Dashboard under
# Project Settings > API > service_role (HEMLIG — dela aldrig, exponera
# aldrig till frontend/VITE_-prefixade variabler).
SUPABASE_SERVICE_ROLE_KEY=byt-ut-mot-din-service-role-key

# FöretagsAPI (foretagsapi.se) — autouppslag av företagsuppgifter (namn,
# org.nummer, adress) i Kunder/Leverantörer-formulären, se
# src/hooks/useCompanyLookup.js. Precis som Stripe/Resend ovan: aldrig
# VITE_-prefixad, servern (api/company-access.js) är ensam om att prata
# med foretagsapi.se — klienten anropar bara vår egen /api/company-access.
# Utan den här satt visas formulären precis som innan (ingen autouppslags-
# knapp aktiveras, inget kraschar).
FORETAGSAPI_KEY=byt-ut-mot-din-foretagsapi-nyckel
